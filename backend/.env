# CloudVuln Environment Configuration
# ============================================

# JWT Security Keys (change in production!)
JWT_SECRET_KEY=cloudvuln-secops-super-secret-jwt-key-2026-prod-grade-change-me
JWT_REFRESH_SECRET_KEY=cloudvuln-secops-super-secret-refresh-key-2026-prod-grade-change-me
SECRET_KEY=cloudvuln-secops-super-secret-jwt-key-2026-prod-grade-change-me
REFRESH_SECRET_KEY=cloudvuln-secops-super-secret-refresh-key-2026-prod-grade-change-me

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON array string)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# SQLite Database
DATABASE_URL=sqlite:///./cloudvuln.db

# Logging
LOG_LEVEL=INFO

# App
APP_ENV=development
PROJECT_NAME=CloudVuln Security Engine
