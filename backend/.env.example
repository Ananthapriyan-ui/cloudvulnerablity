# CloudVuln Backend Environment Configuration
PROJECT_NAME="CloudVuln Security Engine"
APP_ENV=production
LOG_LEVEL=INFO

# Security Keys (Generate strong 64-character random strings in production)
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production
REFRESH_SECRET_KEY=change-this-to-a-secure-random-64-character-refresh-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://cloudvuln-frontend.vercel.app,http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Database Configuration (Leave empty for default local cloudvuln.db or specify path/URI)
DATABASE_URL=sqlite:////var/data/cloudvuln.db
